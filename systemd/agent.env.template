# Plumb — Agent Environment
# Copy to /etc/plumb/agent.env and chmod 600. NEVER commit the filled-in copy.
# Placeholders only — fill with your real keys on the host.

# Pi (Z.AI)
ZAI_API_KEY=<your-zai-api-key>
PI_PROVIDER=zai
PI_MODEL=zai/glm-4.5-air

# Cursor
CURSOR_API_KEY=<your-cursor-api-key>

# Claude (Anthropic)
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OpenCode (Z.AI)
OPENAI_API_KEY=<your-zai-api-key>
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# VENOM (Z.AI)
# ZAI_API_KEY shared with Pi above

# Plumb A2A auth — set when binding a non-loopback interface (--listen 0.0.0.0).
# Wire into a unit with: ExecStart=... --key ${PLUMB_KEY}
# PLUMB_KEY=<long-random-token>
